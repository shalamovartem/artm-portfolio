{
  "name": "artem-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node server.cjs",
    "admin": "node scripts/set-admin.mjs",
    "format": "prettier --write app lib scripts *.json *.mjs *.cjs README.md deploy/*.md",
    "format:check": "prettier --check app lib scripts *.json *.mjs *.cjs README.md deploy/*.md",
    "typecheck": "tsc --noEmit",
    "test:integration": "python3 tests/editor-update-check.py",
    "licenses": "node scripts/generate-licenses.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.13.0",
    "marked": "^18.1.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  },
